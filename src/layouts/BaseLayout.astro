---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../content/profile";
import { communitySocials, primarySocials, secondarySocials } from "../content/social";
import "../styles/global.css";
interface Props { title?: string; description?: string; image?: string; }
const { title = `${profile.name} — Scientific Computing & Machine Learning`, description = profile.intro, image = profile.portrait } = Astro.props;
const canonical = new URL(Astro.url.pathname, profile.site);
const socialUrls = [...primarySocials, ...secondarySocials, ...communitySocials].map((item)=>item.href);
const personData = {"@context":"https://schema.org","@type":"Person",name:profile.name,url:profile.site,image:new URL(profile.portrait,profile.site).href,email:`mailto:${profile.email}`,sameAs:socialUrls,affiliation:{"@type":"CollegeOrUniversity",name:profile.institution},alumniOf:[{"@type":"CollegeOrUniversity",name:"University of Engineering and Technology, Lahore"},{"@type":"CollegeOrUniversity",name:"The Islamia University of Bahawalpur"}],knowsAbout:["Scientific computing","Automatic differentiation","Machine learning","Interval arithmetic","Neural-network pruning","High-performance computing","C++","Python","PyTorch","TensorFlow"]};
const websiteData = {"@context":"https://schema.org","@type":"WebSite",name:profile.name,url:profile.site,description};
---
<!doctype html><html lang="en"><head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="generator" content={Astro.generator}/><meta name="description" content={description}/><meta name="theme-color" content="#102f38"/>
  <link rel="icon" type="image/png" href="/images/ff5b3b9a-189b-49d5-b454-25c2ef055441.png"/><link rel="canonical" href={canonical}/>
  <meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={profile.name}/><meta property="og:image" content={new URL(image,profile.site)}/><meta property="og:image:alt" content={profile.name}/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,profile.site)}/>
  <script is:inline>document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');</script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personData)}/><script is:inline type="application/ld+json" set:html={JSON.stringify(websiteData)}/><title>{title}</title>
</head><body><a class="skip-link" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/></body></html>
