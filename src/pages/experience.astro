---
import BaseLayout from "../layouts/BaseLayout.astro";
import { languages } from "../content/profile";
import { experiences } from "../content/experience";
import { education,credentials } from "../content/education";
import { seo } from "../content/seo";
---
<BaseLayout title={seo.experience.title} description={seo.experience.description}>
  <header class="page-hero"><div class="container"><p class="eyebrow">Experience & Education</p><h1>A career across research, teaching, and software engineering.</h1><p class="lede">Doctoral scientific-computing research builds on earlier university teaching and database-backed software engineering experience. <a class="text-link" href="/research/">Explore the research programme.</a></p></div></header>
  <section class="section"><div class="container timeline-layout"><aside><p class="eyebrow">Professional experience</p><h2>Research, teaching, and software engineering experience.</h2></aside><div class="timeline">{experiences.map((item)=><article><div class="period">{item.period}</div><div><span class:list={["kind",item.kind]}>{item.kind}</span><h3>{item.role}</h3><h4>{item.organization}{item.location&&<small>{item.location}</small>}</h4><p>{item.summary}</p><ul>{item.evidence.map((evidence)=><li>{evidence}</li>)}</ul></div></article>)}</div></div></section>
  <section class="section tinted"><div class="container timeline-layout"><aside><p class="eyebrow">Education</p><h2>Computer science foundation.</h2></aside><div class="timeline education">{education.map((item)=><article><div class="period">{item.period}</div><div><h3>{item.qualification}</h3><h4>{item.institution}</h4><p>{item.detail}</p></div></article>)}</div></div></section>
  <section class="section"><div class="container timeline-layout"><aside><p class="eyebrow">Scholarships & credential</p><h2>Selected support and training.</h2></aside><ul class="credentials">{credentials.map((item)=><li>{item}</li>)}</ul></div></section>
  <section class="section tinted"><div class="container timeline-layout"><aside><p class="eyebrow">Languages</p><h2>Language proficiency.</h2></aside><dl class="languages">{languages.map((item)=><div><dt>{item.language}</dt><dd>{item.proficiency}</dd></div>)}</dl></div></section>
</BaseLayout>
<style>
  .page-hero{padding:clamp(5rem,10vw,9rem) 0}.page-hero h1{max-width:1050px;font-size:clamp(3rem,6.5vw,6.3rem)}.page-hero .lede{max-width:760px}.timeline-layout{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(3rem,8vw,8rem)}.timeline article{display:grid;grid-template-columns:11rem 1fr;gap:2rem;padding:2rem 0;border-top:1px solid var(--line)}.period{color:var(--accent);font:700 .7rem/1.5 var(--mono);text-transform:uppercase}.kind{display:inline-block;margin-bottom:.7rem;padding:.2rem .5rem;background:var(--accent-soft);color:var(--accent);font:700 .62rem var(--mono);text-transform:uppercase}h3{margin:0 0 .4rem;font-size:1.8rem}h4{margin:0 0 1rem;font-size:.95rem}h4 small{display:block;margin-top:.25rem;color:var(--muted);font-weight:400}.timeline p{color:var(--muted)}.timeline ul{display:flex;flex-wrap:wrap;gap:.4rem;margin:1rem 0 0;padding:0;list-style:none}.timeline li{padding:.3rem .6rem;border:1px solid var(--line);font-size:.72rem}.tinted{background:var(--surface)}.education article{padding-block:1.7rem}.credentials,.languages{margin:0;padding:0}.credentials{list-style:none}.credentials li,.languages div{padding:1.2rem 0;border-top:1px solid var(--line)}.languages div{display:grid;grid-template-columns:minmax(8rem,.4fr) 1fr;gap:1rem}.languages dt{font-weight:700}.languages dd{margin:0;color:var(--muted)}@media(max-width:800px){.timeline-layout{grid-template-columns:1fr;gap:2rem}.timeline article{grid-template-columns:1fr;gap:.8rem}}@media(max-width:480px){.languages div{grid-template-columns:1fr;gap:.2rem}}
</style>
