---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { featuredPublications,otherPublications,earlierPublications } from "../content/publications";
import { primarySocials } from "../content/social";
import { seo } from "../content/seo";
const scholar=primarySocials.find((item)=>item.label==="Google Scholar")!;
const orcid=primarySocials.find((item)=>item.label==="ORCID")!;
---
<BaseLayout title={seo.publications.title} description={seo.publications.description}>
  <header class="page-hero"><div class="container hero-grid"><div><p class="eyebrow">Publications</p><h1>Research record.</h1><p class="lede">Current doctoral research is presented first, followed by related work and earlier publications. No citation counts or unverified manuscripts are included.</p><p class="author-note">Research publications may also list the author name as Sher Afghan.</p></div><div class="profiles"><span>External profiles</span><a href={scholar.href} rel="me noreferrer">Google Scholar ↗</a><a href={orcid.href} rel="me noreferrer">ORCID ↗</a></div></div></header>
  <section class="section"><div class="container"><div class="group-head"><div><p class="eyebrow">01 · Featured / core research</p><h2>Algorithmic differentiation and pruning.</h2></div><p>The two publications that best represent my central doctoral research direction.</p></div>{featuredPublications.map((publication,index)=><PublicationEntry publication={publication} featured index={index+1}/>) }<a class="text-link research-context" href="/research/#iasa">Read the research context for IASA and pruning →</a></div></section>
  <section class="section tinted"><div class="container"><div class="group-head"><div><p class="eyebrow">02 · Other publications</p><h2>Related and collaborative work.</h2></div><p>Additional work spanning structured pruning and data-driven computational engineering.</p></div>{otherPublications.map((publication)=><PublicationEntry publication={publication}/>)}</div></section>
  <section class="section"><div class="container"><div class="group-head"><div><p class="eyebrow">03 · Earlier publications</p><h2>Earlier computing research.</h2></div><p>Pre-2018 work retained for a complete downstream publication record, without presenting it as representative of current research.</p></div>{earlierPublications.map((publication)=><PublicationEntry publication={publication}/>)}</div></section>
</BaseLayout>
<style>
  .page-hero{padding:clamp(5rem,10vw,9rem) 0}.hero-grid,.group-head{display:grid;grid-template-columns:1.25fr .75fr;gap:4rem;align-items:end}.page-hero h1{font-size:clamp(4rem,8vw,7rem)}.page-hero .lede{max-width:720px}.author-note{margin:.75rem 0 0;color:var(--muted);font-size:.82rem}.profiles{display:flex;flex-direction:column;align-items:flex-start;gap:.6rem;padding:1.5rem;border:1px solid var(--line)}.profiles span{color:var(--muted);font:700 .68rem var(--mono);text-transform:uppercase}.profiles a{color:var(--accent);font-weight:700;text-underline-offset:.25em}.group-head{margin-bottom:3rem}.group-head>p{max-width:440px;color:var(--muted)}.research-context{display:inline-block;margin-top:1.25rem}.tinted{background:var(--surface)}@media(max-width:750px){.hero-grid,.group-head{grid-template-columns:1fr;gap:1.5rem}}
</style>
<style>
  .group-head { column-gap: 4rem; row-gap: 1rem; align-items: start; }
  .group-head > div { display: contents; }
  .group-head .eyebrow { grid-column: 1 / -1; margin-bottom: 0; }
  .group-head h2 { grid-column: 1; }
  .group-head > p { grid-column: 2; align-self: start; margin-top: .3rem; }
  @media (max-width: 750px) {
    .group-head .eyebrow,
    .group-head h2,
    .group-head > p { grid-column: 1; }
  }
</style>
