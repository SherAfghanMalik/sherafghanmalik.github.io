---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchCard from "../components/ResearchCard.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { profile, quickFacts } from "../content/profile";
import { primarySocials } from "../content/social";
import { researchAreas } from "../content/research";
import { featuredPublications } from "../content/publications";
import { skillGroups } from "../content/skills";
import { experienceSummary } from "../content/experience";
import { seo } from "../content/seo";
---
<BaseLayout title={seo.home.title} description={seo.home.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Sher Afghan <em>Malik</em></h1>
        <p class="headline">{profile.headline}</p>
        <div class="specializations" aria-label="Professional specializations"><span>Research Software</span><span>Numerical Methods</span><span>Efficient ML</span></div>
        <p class="value">{profile.intro}</p>
        <div class="hero-actions"><a class="button" href="/research/">Explore Research →</a><a class="button secondary" href="/publications/">View Publications</a><a class="plain-action" href="/cv/">View CV</a></div>
        <div class="social-row" aria-label="Professional profiles">{primarySocials.map((item)=><a href={item.href} rel="me noreferrer">{item.label} ↗</a>)}</div>
      </div>
      <div class="portrait-wrap">
        <div class="portrait-frame"><picture><source type="image/webp" srcset="/images/sher-afghan-malik-portrait-320.webp 320w, /images/sher-afghan-malik-portrait-640.webp 640w, /images/sher-afghan-malik-portrait-900.webp 900w" sizes="(max-width: 680px) 300px, (max-width: 1100px) 32vw, 360px"/><img src={profile.portrait} alt="Sher Afghan Malik" width="1122" height="1402" fetchpriority="high" decoding="async"/></picture></div>
        <p>{profile.status}</p>
      </div>
    </div>
    <div class="container facts" aria-label="Professional quick facts">{quickFacts.map((fact)=><div><span>{fact.label}</span><strong>{fact.value}</strong></div>)}</div>
  </section>

  <section class="section" id="about"><div class="container split"><div><p class="eyebrow">Professional profile</p><h2>Mathematical methods, implemented and evaluated at scale.</h2></div><div class="prose"><p class="lede">{profile.biography}</p><p>My doctoral work centers on Interval Adjoint Significance Analysis (IASA): using interval tangent and adjoint information to reason about component significance in neural networks. The engineering behind that work includes C++ algorithmic-differentiation code, Python/PyTorch experimentation, Linux debugging, cluster execution, and reproducible research pipelines.</p><p>I am interested in research and engineering roles where numerical reasoning, machine learning, and dependable implementation meet.</p></div></div></section>

  <section class="section tinted"><div class="container"><div class="section-intro"><div><p class="eyebrow">Core expertise</p><h2>Four connected areas of technical depth.</h2></div><p>Derivative computation provides the signal; intervals add bounds; pruning turns the analysis into model structure.</p></div><div class="research-grid">{researchAreas.map((area)=><ResearchCard {...area}/>)}</div><a class="button secondary section-action" href="/research/">Research methods and workflow →</a></div></section>

  <section class="section"><div class="container"><div class="section-intro"><div><p class="eyebrow">Featured research</p><h2>Central work in significance analysis and gradient-aware pruning.</h2></div><p>Selected work on IASA and gradient-aware pruning.</p></div><div>{featuredPublications.map((publication,index)=><PublicationEntry publication={publication} featured index={index+1}/>)}</div><a class="text-link" href="/publications/">See the complete publication record →</a></div></section>

  <section class="section tinted"><div class="container"><section class="toolkit" id="toolkit" aria-labelledby="toolkit-title"><div class="toolkit-head"><p class="eyebrow">Technical toolkit</p><h2 id="toolkit-title">Tools for research, implementation, and execution.</h2></div><div class="toolkit-grid">{skillGroups.map((group)=><article><h3>{group.title}</h3><ul>{group.skills.map((skill)=><li>{skill}</li>)}</ul></article>)}</div></section></div></section>

  <section class="section"><div class="container"><div class="section-intro"><div><p class="eyebrow">Experience snapshot</p><h2>Research, teaching, and software engineering.</h2></div><p>A professional path that combines doctoral research, computer-science education, and hands-on business software development.</p></div><div class="experience-grid">{experienceSummary.map((item,index)=><article><span>0{index+1}</span><h3>{item.label}</h3><p>{item.detail}</p></article>)}</div><div class="actions"><a class="button" href="/experience/">Experience & Education →</a><a class="button secondary" href="/cv/">View HTML CV</a></div></div></section>

  <section class="section contact" id="contact"><div class="container contact-grid"><div><p class="eyebrow">Contact</p><h2>Research, scientific computing, and engineering conversations are welcome.</h2></div><div><p class="lede">I am open to discussing research software, machine learning, numerical computing, R&D, and scientific collaboration opportunities.</p><a class="button" href={`mailto:${profile.email}`}>Email Sher →</a><div class="contact-links">{primarySocials.map((item)=><a href={item.href} rel="me noreferrer">{item.label} ↗</a>)}</div></div></div></section>
</BaseLayout>
<style>
  .hero{padding:clamp(3.25rem,6vw,5.75rem) 0 0}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.65fr);gap:clamp(2.5rem,6vw,6rem);align-items:center}.hero-copy{min-width:0}h1{max-width:850px;margin:0 0 1rem;font-size:clamp(4.4rem,7vw,6.8rem);line-height:.9}h1 em{display:block;color:var(--accent);font-weight:inherit}.headline{max-width:750px;margin-bottom:.7rem;color:var(--ink);font-size:clamp(1.15rem,1.8vw,1.42rem);font-weight:650;line-height:1.45}.specializations{display:flex;flex-wrap:wrap;gap:.45rem .65rem;margin:0 0 1.4rem}.specializations span{padding:.22rem .55rem;border:1px solid var(--line);color:var(--muted);font:650 .64rem var(--mono);letter-spacing:.06em;text-transform:uppercase}.value{max-width:720px;margin-bottom:0;color:var(--muted);font-size:1.04rem}.hero-actions,.actions{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem;margin-top:1.65rem}.plain-action{padding:.7rem;color:var(--accent);font-weight:700;text-underline-offset:.3em}.social-row{display:flex;flex-wrap:wrap;gap:.75rem 1.2rem;margin-top:1.65rem;padding-top:1.1rem;border-top:1px solid var(--line)}.social-row a,.contact-links a{color:var(--muted);font-size:.75rem;font-weight:700;text-underline-offset:.3em}.portrait-wrap{align-self:center}.portrait-frame{position:relative;background:transparent}.portrait-frame img{display:block;width:100%;height:auto;object-fit:contain}.portrait-wrap>p{max-width:330px;margin:.25rem auto 0;padding-left:1rem;border-left:2px solid var(--accent);color:var(--muted);font-size:.78rem;line-height:1.5}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:clamp(2.75rem,5vw,4.5rem);border-top:1px solid var(--line);border-left:1px solid var(--line)}.facts div{min-width:0;padding:1.2rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.facts span,.experience-grid span{display:block;color:var(--accent);font:700 .65rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.facts strong{display:block;margin-top:.4rem;font-size:.8rem;line-height:1.4}.split,.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,9vw,9rem)}.prose{padding-top:2.5rem}.prose p:not(.lede){color:var(--muted)}.tinted,.contact{background:var(--surface)}.section-intro{display:grid;grid-template-columns:1.3fr .7fr;gap:4rem;align-items:end;margin-bottom:3rem}.section-intro>p{max-width:460px;color:var(--muted)}.research-grid{display:grid;grid-template-columns:1fr 1fr}.research-grid :global(article){padding-right:2rem}.section-action{margin-top:2rem}.experience-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.experience-grid article{min-height:230px;padding:1.5rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.experience-grid h3{margin:2.2rem 0 .8rem;font-size:1.35rem}.experience-grid p{color:var(--muted);font-size:.88rem}.toolkit{margin-top:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.toolkit-head{display:grid;grid-template-columns:.65fr 1.35fr;gap:2rem;align-items:end;padding:1.5rem 0;border-bottom:1px solid var(--line)}.toolkit-head .eyebrow{margin:0}.toolkit-head h2{margin:0;font-size:clamp(1.35rem,2vw,1.8rem)}.toolkit-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.toolkit-grid article{min-width:0;padding:1.5rem 1.25rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.toolkit-grid article:nth-child(3n){border-right:0}.toolkit-grid article:nth-last-child(-n+2){border-bottom:0}.toolkit-grid h3{margin:0 0 .8rem;color:var(--accent);font:700 .68rem/1.4 var(--mono);letter-spacing:.05em;text-transform:uppercase}.toolkit-grid ul{margin:0;padding:0;list-style:none}.toolkit-grid li{margin:.26rem 0;color:var(--muted);font-size:.84rem;line-height:1.5}.contact-grid{align-items:center}.contact-links{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem}
  @media(max-width:1100px) and (min-width:681px){h1{font-size:clamp(4rem,7vw,5.75rem)}.hero-grid{grid-template-columns:minmax(0,1.25fr) minmax(285px,.75fr);gap:2.75rem}.headline{font-size:1.15rem}.facts strong{font-size:.76rem}}
  @media(max-width:950px){.hero-grid{grid-template-columns:1.2fr .8fr}.facts{grid-template-columns:1fr 1fr}.section-intro,.split,.contact-grid{grid-template-columns:1fr;gap:1rem}.prose{padding-top:0}.capability-grid{grid-template-columns:1fr 1fr}.toolkit-grid{grid-template-columns:1fr 1fr}.toolkit-grid article,.toolkit-grid article:nth-child(3n){border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.toolkit-grid article:nth-child(2n){border-right:0}.toolkit-grid article:last-child{border-bottom:0}.research-grid{grid-template-columns:1fr}}
  @media(max-width:680px){.hero-grid{grid-template-columns:minmax(0,1fr);gap:1.25rem;align-items:start}.hero-copy{display:contents}.hero-copy h1{order:1;font-size:clamp(3.2rem,16vw,4.5rem);overflow-wrap:anywhere}.headline{order:2}.specializations{order:3;margin-bottom:0}.portrait-wrap{order:4;width:min(78vw,300px);margin:.25rem auto .5rem}.value{order:5}.hero-actions{order:6;display:grid;grid-template-columns:minmax(0,1fr);width:100%;margin-top:.5rem}.social-row{order:7;display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:.25rem}.hero-copy p{max-width:100%;overflow-wrap:anywhere}.hero-actions .button,.hero-actions .plain-action{width:100%;max-width:100%;text-align:center}.portrait-frame img{width:100%;height:auto}.facts,.capability-grid,.experience-grid{grid-template-columns:1fr}.toolkit-head{grid-template-columns:1fr;gap:.75rem}.toolkit-grid{grid-template-columns:1fr}.toolkit-grid article,.toolkit-grid article:nth-child(2n),.toolkit-grid article:nth-child(3n){border-right:0;border-bottom:1px solid var(--line)}.toolkit-grid article:last-child{border-bottom:0}.capability-grid article,.experience-grid article{min-height:auto}}
</style>
<style>
  .split { align-items: start; }
  .split > .prose { padding-top: 0; }
  .section-intro { column-gap: 4rem; row-gap: 1rem; align-items: start; }
  .section-intro > div { display: contents; }
  .section-intro .eyebrow { grid-column: 1 / -1; margin-bottom: 0; }
  .section-intro h2 { grid-column: 1; }
  .section-intro > p { grid-column: 2; align-self: start; margin-top: .3rem; }
  .toolkit { border-bottom: 0 !important; }
  .toolkit-head { grid-template-columns: 1fr; gap: 0; align-items: start; border-bottom: 0 !important; }
  .toolkit-head .eyebrow { margin-bottom: 4rem; }
  .toolkit-grid > article:nth-child(n) { border: 0 !important; }
  .toolkit-grid { margin-top: 2rem; }
  @media (max-width: 950px) {
    .toolkit-head .eyebrow { margin-bottom: 1.25rem; }
    .toolkit-grid { margin-top: 2rem; }
    .section-intro .eyebrow,
    .section-intro h2,
    .section-intro > p { grid-column: 1; }
  }
</style>
