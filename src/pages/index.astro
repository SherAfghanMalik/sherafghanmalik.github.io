---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchCard from "../components/ResearchCard.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { profile, quickFacts } from "../content/profile";
import { primarySocials } from "../content/social";
import { researchAreas } from "../content/research";
import { featuredPublications } from "../content/publications";
import { skillGroups, engineeringCapabilities } from "../content/skills";
import { experienceSummary } from "../content/experience";
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Research software · Numerical methods · Efficient ML</p>
        <h1>Sher Afghan <em>Malik</em></h1>
        <p class="headline">{profile.headline}</p>
        <p class="value">{profile.intro}</p>
        <div class="hero-actions"><a class="button" href="/research/">Explore Research →</a><a class="button secondary" href="/publications/">View Publications</a><a class="plain-action" href="/cv/">View CV</a></div>
        <div class="social-row" aria-label="Professional profiles">{primarySocials.map((item)=><a href={item.href} rel="me noreferrer">{item.label} ↗</a>)}</div>
      </div>
      <div class="portrait-wrap">
        <div class="portrait-frame"><img src={profile.portrait} alt="Sher Afghan Malik" width="900" height="1125" fetchpriority="high"/></div>
        <p>{profile.status}</p>
      </div>
    </div>
    <div class="container facts" aria-label="Professional quick facts">{quickFacts.map((fact)=><div><span>{fact.label}</span><strong>{fact.value}</strong></div>)}</div>
  </section>

  <section class="section" id="about"><div class="container split"><div><p class="eyebrow">Professional profile</p><h2>Mathematical methods, implemented and evaluated at scale.</h2></div><div class="prose"><p class="lede">{profile.biography}</p><p>My doctoral work centers on Interval Adjoint Significance Analysis (IASA): using interval tangent and adjoint information to reason about component significance in neural networks. The engineering behind that work includes C++ automatic-differentiation code, Python/PyTorch experimentation, Linux debugging, GPU execution, Slurm scheduling, and reproducible research pipelines.</p><p>I am interested in research and engineering roles where numerical reasoning, machine learning, and dependable implementation meet.</p></div></div></section>

  <section class="section tinted"><div class="container"><div class="section-intro"><div><p class="eyebrow">Core expertise</p><h2>Four connected areas of technical depth.</h2></div><p>Derivative computation provides the signal; intervals add bounds; pruning turns the analysis into model structure; HPC makes careful evaluation possible.</p></div><div class="research-grid">{researchAreas.map((area)=><ResearchCard {...area}/>)}</div><a class="button secondary section-action" href="/research/">Research methods and workflow →</a></div></section>

  <section class="section"><div class="container"><div class="section-intro"><div><p class="eyebrow">Featured research</p><h2>Central work in significance analysis and gradient-aware pruning.</h2></div><p>These two publications best represent the core direction of my doctoral research.</p></div><div>{featuredPublications.map((publication,index)=><PublicationEntry publication={publication} featured index={index+1}/>)}</div><a class="text-link" href="/publications/">See the complete publication record →</a></div></section>

  <section class="section tinted"><div class="container"><div class="section-intro"><div><p class="eyebrow">Engineering capabilities</p><h2>Research software beyond the experiment notebook.</h2></div><p>Concrete implementation and execution skills for scientific-computing, ML, research-engineering, and HPC roles.</p></div><div class="capability-grid">{engineeringCapabilities.map((item,index)=><article><span>0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><div class="toolkit"><h3>Technical toolkit</h3>{skillGroups.map((group)=><div><strong>{group.title}</strong><p>{group.skills.join(" · ")}</p></div>)}</div></div></section>

  <section class="section"><div class="container"><div class="section-intro"><div><p class="eyebrow">Experience snapshot</p><h2>Research, teaching, and software engineering.</h2></div><p>A professional path that combines doctoral research, computer-science education, and hands-on business software development.</p></div><div class="experience-grid">{experienceSummary.map((item,index)=><article><span>0{index+1}</span><h3>{item.label}</h3><p>{item.detail}</p></article>)}</div><div class="actions"><a class="button" href="/experience/">Experience & Education →</a><a class="button secondary" href="/cv/">View HTML CV</a></div></div></section>

  <section class="section contact" id="contact"><div class="container contact-grid"><div><p class="eyebrow">Contact</p><h2>Research, scientific computing, and engineering conversations are welcome.</h2></div><div><p class="lede">I am open to discussing research software, machine learning, numerical computing, HPC/GPU engineering, R&D, and scientific collaboration opportunities.</p><a class="button" href={`mailto:${profile.email}`}>Email Sher →</a><div class="contact-links">{primarySocials.map((item)=><a href={item.href} rel="me noreferrer">{item.label} ↗</a>)}</div></div></div></section>
</BaseLayout>
<style>
  .hero{padding:clamp(3.5rem,7vw,6.5rem) 0 0}.hero-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.65fr);gap:clamp(3rem,8vw,7rem);align-items:center}h1{max-width:850px;margin:1rem 0 1.2rem;font-size:clamp(3.6rem,7.5vw,7.2rem)}h1 em{display:block;color:var(--accent);font-weight:inherit}.headline{max-width:750px;color:var(--ink);font-size:clamp(1.15rem,2vw,1.45rem);font-weight:650}.value{max-width:720px;color:var(--muted);font-size:1.08rem}.hero-actions,.actions{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem;margin-top:2rem}.plain-action{padding:.7rem;color:var(--accent);font-weight:700;text-underline-offset:.3em}.social-row{display:flex;flex-wrap:wrap;gap:.75rem 1.2rem;margin-top:2rem;padding-top:1.2rem;border-top:1px solid var(--line)}.social-row a,.contact-links a{color:var(--muted);font-size:.75rem;font-weight:700;text-underline-offset:.3em}.portrait-frame{position:relative;overflow:hidden;background:var(--surface);box-shadow:var(--shadow)}.portrait-frame::after{content:"";position:absolute;inset:0;border:1px solid color-mix(in srgb,var(--paper) 28%,transparent);pointer-events:none}.portrait-frame img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center 30%}.portrait-wrap>p{margin:1rem 0 0;padding-left:1rem;border-left:2px solid var(--accent);color:var(--muted);font-size:.78rem;line-height:1.5}.facts{display:grid;grid-template-columns:repeat(4,1fr);margin-top:clamp(3rem,6vw,5rem);border-top:1px solid var(--line);border-left:1px solid var(--line)}.facts div{padding:1.2rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.facts span,.capability-grid span,.experience-grid span{display:block;color:var(--accent);font:700 .65rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.facts strong{display:block;margin-top:.4rem;font-size:.82rem;line-height:1.4}.split,.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,9vw,9rem)}.prose{padding-top:2.5rem}.prose p:not(.lede){color:var(--muted)}.tinted,.contact{background:var(--surface)}.section-intro{display:grid;grid-template-columns:1.3fr .7fr;gap:4rem;align-items:end;margin-bottom:3rem}.section-intro>p{max-width:460px;color:var(--muted)}.research-grid{display:grid;grid-template-columns:1fr 1fr}.research-grid :global(article){padding-right:2rem}.section-action{margin-top:2rem}.capability-grid,.experience-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.experience-grid{grid-template-columns:repeat(3,1fr)}.capability-grid article,.experience-grid article{min-height:230px;padding:1.5rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.capability-grid h3,.experience-grid h3{margin:2.2rem 0 .8rem;font-size:1.35rem}.capability-grid p,.experience-grid p{color:var(--muted);font-size:.88rem}.toolkit{display:grid;grid-template-columns:.8fr repeat(5,1fr);gap:0;margin-top:3rem;border-top:1px solid var(--line)}.toolkit>h3,.toolkit>div{padding:1.2rem 1rem;border-bottom:1px solid var(--line)}.toolkit h3{font-size:1.25rem}.toolkit strong{color:var(--accent);font:700 .67rem var(--mono);text-transform:uppercase}.toolkit p{margin:.6rem 0 0;color:var(--muted);font-size:.78rem}.contact-grid{align-items:center}.contact-links{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem}
  @media(max-width:950px){.hero-grid{grid-template-columns:1.2fr .8fr}.facts{grid-template-columns:1fr 1fr}.section-intro,.split,.contact-grid{grid-template-columns:1fr;gap:1rem}.prose{padding-top:0}.capability-grid{grid-template-columns:1fr 1fr}.toolkit{grid-template-columns:1fr 1fr}.toolkit>h3{grid-column:1/-1}.research-grid{grid-template-columns:1fr}}
  @media(max-width:680px){.hero-grid{grid-template-columns:minmax(0,1fr);gap:2.5rem}.hero-copy{width:100%;max-width:calc(100vw - 1.5rem);min-width:0;overflow:hidden}.hero-copy h1{font-size:clamp(3.1rem,16vw,4.5rem);overflow-wrap:anywhere}.hero-copy p{max-width:100%;overflow-wrap:anywhere}.hero-actions{display:grid;grid-template-columns:minmax(0,1fr);width:100%}.hero-actions .button,.hero-actions .plain-action{width:100%;max-width:100%;text-align:center}.social-row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.portrait-wrap{width:100%;max-width:430px}.portrait-frame{max-height:520px}.portrait-frame img{object-position:center 24%}.facts,.capability-grid,.experience-grid{grid-template-columns:1fr}.toolkit{grid-template-columns:1fr}.toolkit>h3{grid-column:auto}.capability-grid article,.experience-grid article{min-height:auto}}
</style>
