---
import BaseLayout from "../layouts/BaseLayout.astro";
import { languages, profile } from "../content/profile";
import { primarySocials } from "../content/social";
import { experiences } from "../content/experience";
import { education } from "../content/education";
import { skillGroups } from "../content/skills";
import { featuredPublications } from "../content/publications";
---
<BaseLayout title={`HTML CV — ${profile.name}`} description={`Professional HTML CV for ${profile.name}: doctoral research, scientific software, machine learning, HPC, teaching, and engineering experience.`}>
  <header class="cv-head"><div class="container"><div><p class="eyebrow">HTML curriculum vitae</p><h1>{profile.name}</h1><p class="headline">{profile.headline}</p><p class="status">{profile.status}</p></div><div class="cv-contact"><a href={`mailto:${profile.email}`}>{profile.email}</a>{primarySocials.map((item)=><a href={item.href} rel="me noreferrer">{item.label} ↗</a>)}</div></div></header>
  <section class="cv-section"><div class="container cv-grid"><h2>Profile</h2><div><p class="lede">{profile.positioning}</p><p>{profile.biography}</p></div></div></section>
  <section class="cv-section"><div class="container cv-grid"><h2>Experience</h2><div>{experiences.map((item)=><article class="entry"><span>{item.period}</span><div><h3>{item.role}</h3><h4>{item.organization}</h4><p>{item.summary}</p><p class="evidence">{item.evidence.join(" · ")}</p></div></article>)}</div></div></section>
  <section class="cv-section"><div class="container cv-grid"><h2>Education</h2><div>{education.map((item)=><article class="entry"><span>{item.period}</span><div><h3>{item.qualification}</h3><h4>{item.institution}</h4><p>{item.detail}</p></div></article>)}</div></div></section>
  <section class="cv-section"><div class="container cv-grid"><h2>Technical skills</h2><div class="skills">{skillGroups.map((group)=><article><h3>{group.title}</h3><p>{group.skills.join(" · ")}</p></article>)}</div></div></section>
  <section class="cv-section"><div class="container cv-grid"><h2>Languages</h2><div class="language-list">{languages.map((item)=><p><strong>{item.language}</strong><span>{item.proficiency}</span></p>)}</div></div></section>
  <section class="cv-section"><div class="container cv-grid"><h2>Selected publications</h2><div>{featuredPublications.map((publication)=><article class="entry publication"><span>{publication.year}</span><div><h3>{publication.title}</h3><p>{publication.authors}</p><p>{publication.venue}</p></div></article>)}<a class="text-link" href="/publications/">Complete publication record →</a></div></div></section>
  <section class="cv-note"><div class="container"><p>This HTML CV contains the currently verified professional record. A new downloadable PDF CV will be added later; the obsolete historical CV is not published.</p></div></section>
</BaseLayout>
<style>
  .cv-head{padding:clamp(4rem,8vw,7rem) 0;border-bottom:1px solid var(--line)}.cv-head>.container{display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:end}.cv-head h1{margin:.8rem 0;font-size:clamp(3.7rem,7vw,6.5rem)}.headline{font-size:1.2rem;font-weight:650}.status{max-width:700px;color:var(--muted)}.cv-contact{display:flex;flex-direction:column;align-items:flex-end;gap:.45rem}.cv-contact a{color:var(--accent);font-size:.8rem;font-weight:700;text-underline-offset:.25em}.cv-section{padding:3.5rem 0;border-bottom:1px solid var(--line)}.cv-grid{display:grid;grid-template-columns:12rem 1fr;gap:clamp(2rem,7vw,7rem)}.cv-grid>h2{font:700 .72rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}.cv-grid>div{max-width:850px}.cv-grid p{color:var(--muted)}.entry{display:grid;grid-template-columns:11rem 1fr;gap:2rem;padding:1.4rem 0;border-top:1px solid var(--line)}.entry>span{color:var(--accent);font:700 .68rem/1.5 var(--mono);text-transform:uppercase}.entry h3{margin:0 0 .3rem;font-size:1.35rem}.entry h4{margin:0 0 .7rem}.entry p{margin:.3rem 0;font-size:.86rem}.evidence{font-size:.75rem!important}.skills{display:grid;grid-template-columns:1fr 1fr}.skills article{padding:1.2rem;border-top:1px solid var(--line)}.skills h3{font-size:1.1rem}.language-list p{display:grid;grid-template-columns:9rem 1fr;gap:1rem;margin:0;padding:.8rem 0;border-top:1px solid var(--line)}.language-list span{color:var(--muted)}.publication h3{font-size:1.2rem}.cv-note{padding:1.5rem 0;background:var(--surface);color:var(--muted);font-size:.78rem}@media(max-width:700px){.cv-head>.container,.cv-grid{grid-template-columns:1fr}.cv-contact{align-items:flex-start}.entry{grid-template-columns:1fr;gap:.5rem}.skills{grid-template-columns:1fr}}@media(max-width:420px){.language-list p{grid-template-columns:1fr;gap:.15rem}}
  @media print{.site-header,footer,.cv-note{display:none}.cv-section{padding:1.5rem 0}.cv-head{padding:2rem 0}}
</style>
