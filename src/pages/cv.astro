---
import BaseLayout from "../layouts/BaseLayout.astro";
import { seo } from "../content/seo";

const cvOptions = [
  {
    language: "English",
    title: "Technical & Research CV",
    description: "Scientific computing, machine learning, research software engineering, C++ / Python, algorithmic differentiation, and HPC.",
    action: "Download CV — English",
    meta: "PDF · 2 pages",
    href: "/cv/Sher_Afghan_Malik_Technical_Research_CV_EN.pdf",
  },
  {
    language: "Deutsch",
    title: "Technischer & Forschungs-Lebenslauf",
    description: "Scientific Computing, Machine Learning, Forschungssoftwareentwicklung, C++ / Python, algorithmische Differenzierung und HPC.",
    action: "Lebenslauf herunterladen — Deutsch",
    meta: "PDF · 2 Seiten",
    href: "/cv/Sher_Afghan_Malik_Technical_Research_CV_DE.pdf",
  },
] as const;
---
<BaseLayout title={seo.cv.title} description={seo.cv.description}>
  <header class="cv-hero"><div class="container"><p class="eyebrow">Curriculum Vitae</p><h1>CV</h1><p class="lede">Technical and research CV focused on scientific computing, machine learning, algorithmic differentiation, research software engineering, and HPC.</p><p class="profile-line">Computer scientist and doctoral researcher developing C++ and Python software across numerical computing, machine learning, and research engineering.</p><p class="tool-line">C++ · Python · PyTorch · TensorFlow/Keras · dco/c++ · Linux · Slurm · GPU/HPC</p></div></header>

  <section class="section"><div class="container"><div class="download-grid">{cvOptions.map((option)=><article><p class="language">{option.language}</p><h2>{option.title}</h2><p>{option.description}</p><div class="download-footer"><span>{option.meta}</span><a class="button" href={option.href} download>{option.action}</a></div></article>)}</div><div class="experience-link"><p>Professional roles, education, and career context are available in the web profile.</p><a class="text-link" href="/experience/">View detailed experience →</a></div></div></section>
</BaseLayout>
<style>
  .cv-hero{padding:clamp(5rem,10vw,9rem) 0;border-bottom:1px solid var(--line)}.cv-hero h1{margin:.8rem 0;font-size:clamp(4rem,8vw,7rem)}.cv-hero .lede{max-width:850px}.profile-line{max-width:760px;color:var(--muted)}.tool-line{max-width:850px;margin-top:1.5rem;color:var(--accent);font:700 .72rem/1.7 var(--mono);letter-spacing:.03em}.download-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1.25rem,3vw,2.5rem)}.download-grid article{display:flex;min-height:360px;flex-direction:column;padding:clamp(1.5rem,3vw,2.5rem);border:1px solid var(--line)}.language{margin:0 0 2.5rem;color:var(--accent);font:700 .68rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.download-grid h2{font-size:clamp(2rem,3vw,3rem)}.download-grid article>p:not(.language){max-width:560px;color:var(--muted)}.download-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:2rem}.download-footer span{color:var(--muted);font:700 .68rem var(--mono);text-transform:uppercase}.experience-link{display:flex;align-items:center;justify-content:space-between;gap:2rem;margin-top:clamp(2.5rem,5vw,4rem);padding-top:2rem;border-top:1px solid var(--line)}.experience-link p{margin:0;color:var(--muted)}@media(max-width:760px){.download-grid{grid-template-columns:1fr}.download-grid article{min-height:320px}.experience-link{align-items:flex-start;flex-direction:column;gap:.75rem}}@media(max-width:420px){.download-footer{align-items:flex-start;flex-direction:column}.download-footer .button{width:100%;text-align:center}}
</style>
