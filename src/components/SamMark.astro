---
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 48 48" role="img" aria-label="SAM monogram">
  <path class="mark-frame" d="M5 5h38v38H5z"/>
  <path class="mark-letter" d="M18 16.5H9v7h9v8H9M20.5 31.5l3.7-15h3.6l3.7 15m-9.7-5h8.4M33.5 31.5v-15l4.5 7 4.5-7v15"/>
  <path class="mark-accent" d="M5 37v6h6"/>
</svg>
<style>
  svg{display:block;color:var(--ink)}.mark-frame,.mark-letter,.mark-accent{fill:none;stroke:currentColor;stroke-linecap:square;stroke-linejoin:miter}.mark-frame{stroke-width:1.25}.mark-letter{stroke-width:1.65}.mark-accent{stroke:var(--accent);stroke-width:3}
</style>
