---
import type { Publication } from "../content/publications";
interface Props { publication: Publication; featured?: boolean; index?: number; }
const { publication, featured = false, index } = Astro.props;
---
<article class:list={["publication", {featured}]}>
  <div class="pub-meta"><span>{index ? String(index).padStart(2,"0") : publication.year}</span><strong>{publication.year}</strong></div>
  <div>
    <h3>{publication.title}</h3>
    {publication.authors && <p class="authors">{publication.authors}</p>}
    <p class="venue">{publication.venue}{publication.details && <> · {publication.details}</>}</p>
    <ul class="tags">{publication.tags.map((tag)=><li>{tag}</li>)}</ul>
  </div>
  {publication.links && <div class="links">{publication.links.map((link)=><a href={link.href} rel="noreferrer">{link.label} ↗</a>)}</div>}
</article>
<style>
  .publication{display:grid;grid-template-columns:5rem minmax(0,1fr) auto;gap:1.5rem;padding:2rem 0;border-top:1px solid var(--line)}.pub-meta{display:flex;flex-direction:column;color:var(--accent);font:700 .72rem var(--mono)}.pub-meta strong{margin-top:.3rem;color:var(--muted);font-weight:500}.publication:not(.featured) .pub-meta span{display:none}h3{max-width:800px;margin:0 0 .65rem;font-size:clamp(1.25rem,2vw,1.75rem);line-height:1.2}.featured h3{font-size:clamp(1.55rem,2.5vw,2.2rem)}p{margin:.25rem 0}.authors{color:var(--ink);font-size:.92rem}.venue{color:var(--muted);font-size:.88rem}.tags{display:flex;flex-wrap:wrap;gap:.4rem;margin:1rem 0 0;padding:0;list-style:none}.tags li{padding:.23rem .55rem;background:var(--surface);color:var(--muted);font:600 .66rem var(--mono)}.links{display:flex;flex-direction:column;align-items:flex-end;gap:.5rem}.links a{color:var(--accent);font-size:.78rem;font-weight:700;text-underline-offset:.25em}@media(max-width:700px){.publication{grid-template-columns:3rem 1fr}.links{grid-column:2;align-items:flex-start;flex-direction:row;flex-wrap:wrap}}
</style>
