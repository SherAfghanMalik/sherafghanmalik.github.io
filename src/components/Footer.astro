---
import { profile } from "../content/profile";
import { communitySocials, primarySocials, secondarySocials } from "../content/social";
const year = new Date().getFullYear();
---
<footer>
  <div class="container footer-grid">
    <div class="identity"><a href="/">{profile.name}</a><p>{profile.headline}</p><p class="status">{profile.status}</p></div>
    <div><h2>Navigate</h2><ul><li><a href="/research/">Research</a></li><li><a href="/publications/">Publications</a></li><li><a href="/experience/">Experience</a></li><li><a href="/cv/">CV</a></li></ul></div>
    <div><h2>Profiles</h2><ul>{primarySocials.map((item)=><li><a href={item.href} rel="me noreferrer">{item.label} ↗</a></li>)}</ul></div>
    <div><h2>Also on</h2><ul>{secondarySocials.map((item)=><li><a href={item.href} rel="me noreferrer">{item.label} ↗</a></li>)}{communitySocials.map((item)=><li class="community"><a href={item.href} rel="me noreferrer">{item.label} ↗</a></li>)}</ul></div>
  </div>
  <div class="container footer-bottom"><span>© {year} {profile.name}</span><span>Built for the open web · Aachen, Germany</span></div>
</footer>
<style>
  footer{padding:4rem 0 2rem;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:1.7fr repeat(3,1fr);gap:3rem}.identity>a{font-family:var(--display);font-size:1.55rem;text-decoration:none}.identity p{max-width:380px;margin:.6rem 0 0;color:var(--muted);font-size:.8rem}.identity .status{margin-top:1rem}h2{margin:0 0 1rem;font:700 .68rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}ul{margin:0;padding:0;list-style:none}li{margin:.45rem 0}li a{color:var(--muted);font-size:.84rem;text-underline-offset:.25em}.community{opacity:.68}.community:first-of-type{margin-top:.9rem}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--line);color:var(--muted);font-size:.72rem}@media(max-width:800px){.footer-grid{grid-template-columns:1fr 1fr}.identity{grid-column:1/-1}}@media(max-width:480px){.footer-grid{grid-template-columns:1fr}.identity{grid-column:auto}.footer-bottom{flex-direction:column}}
</style>
